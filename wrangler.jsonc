{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manyatta-kisumu-youth",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "manyatta-kisumu-youth.com",
      "custom_domain": true,
      "zone_name": "manyatta-kisumu-youth.com"
    },
    {
      "pattern": "www.manyatta-kisumu-youth.com",
      "custom_domain": true,
      "zone_name": "manyatta-kisumu-youth.com"
    }
  ],
  "assets": {
    "directory": "frontend"
  }
}
