# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave POSTGRES_HOST empty to use SQLite automatically (zero setup, good
# for a quick local check). Set it to use real PostgreSQL instead — e.g. a
# free Neon/Supabase/Render Postgres instance, or a local install.
POSTGRES_HOST=
POSTGRES_DB=mkdy_django
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Frontend origin allowed to call this API from the browser
CORS_ALLOWED_ORIGINS=http://localhost:8000

# --- Node auth/membership service ---
# Base URL of the node-service, and the shared secret it expects on
# server-to-server calls. Must match INTERNAL_API_KEY in node-service/.env
NODE_SERVICE_URL=http://localhost:5001
INTERNAL_API_KEY=change-this-shared-internal-key

# --- M-Pesa (Safaricom Daraja API) — sandbox credentials to start with ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL (e.g. via ngrok in development)
MPESA_CALLBACK_URL=https://your-domain.example.com/api/payments/mpesa/callback/

# --- PayPal ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Card processor (Flutterwave example — swap for Paystack/Stripe if preferred) ---
CARD_PROVIDER=flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
