# Server
PORT=5001
NODE_ENV=production

# PostgreSQL — same variable names as django-service/.env, but a different
# database (this service should never share a database with Django; they're
# linked only by email + INTERNAL_API_KEY, never a shared table).
# If you don't have Postgres installed locally, a free instance on
# Neon (neon.tech), Supabase, or Render works too — see node-service/README.md.
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=mkdy_auth
POSTGRES_USER=mkdy_node_user
POSTGRES_PASSWORD=replace-with-node-postgres-password

# JWT
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d

# Shared secret used ONLY for server-to-server calls from the Django service
# (e.g. Django calling POST /api/membership/assign after a payment succeeds).
# Must match INTERNAL_API_KEY in django-service/.env
INTERNAL_API_KEY=replace-with-a-long-random-shared-secret

# Allowed origin for browser requests (the frontend). Must be an exact
# origin (not '*') — login/register set an HttpOnly session cookie, and
# browsers only accept credentialed cross-origin cookies with a concrete
# Access-Control-Allow-Origin. In production, set NODE_ENV=production so
# that cookie is marked Secure (HTTPS only).
CLIENT_ORIGIN=http://localhost:8000
